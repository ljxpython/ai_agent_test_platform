# WARNING: Do NOT commit real secrets.
# - Copy this file to `.env` for local development.
# - If a key ever leaks (e.g. committed or shared), rotate it immediately.

# DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek (compat OpenAI env naming)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ZhipuAI / ChatZhipuAI (legacy)
ZHIPUAI_API_KEY=
ZHIPUAI_API_BASE=
ZHIPU_MODEL=glm-4

# Platform v1 JWT (HS256)
PLATFORM_JWT_SECRET=dev-secret-change-me

# v1 CORS (UI/API split)
# Example: CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_ORIGINS=

# LangSmith (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
